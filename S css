:root{
  --brand:#2874f0;
  --muted:#6b7280;
  --card:#ffffff;
  --bg:#f5f7fb;
}
*{box-sizing:border-box}
body{font-family:Inter,system-ui,Segoe UI,Roboto,'Poppins',sans-serif;margin:0;background:var(--bg);color:#111}
a{color:inherit}
.site-header{display:flex;align-items:center;gap:12px;padding:12px 18px;background:linear-gradient(90deg,var(--brand),#1d67d6);color:#fff}
.logo{font-weight:700;font-size:20px}
.search-wrap{flex:1;display:flex;gap:8px}
.search-wrap input{flex:1;padding:10px;border-radius:6px;border:none}
.search-wrap button{padding:10px 12px;border-radius:6px;border:none;background:#fff;color:var(--brand);font-weight:700;cursor:pointer}
.actions{display:flex;gap:10px;align-items:center}
.container{max-width:1200px;margin:18px auto;display:grid;grid-template-columns:260px 1fr;gap:18px;padding:0 16px}
.left-col .panel{background:var(--card);padding:12px;border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,0.04);margin-bottom:12px}
.main-col .panel{margin-bottom:12px}
.top-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.top-controls select{padding:8px;border-radius:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
.card{background:var(--card);padding:12px;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.06);display:flex;flex-direction:column;gap:8px}
.card img{width:100%;height:160px;object-fit:cover;border-radius:8px}
.card h3{margin:0;font-size:15px}
.price{color:var(--brand);font-weight:700}
.rating{font-size:13px;color:#ffb400}
.btn{background:var(--brand);color:white;padding:8px 10px;border:none;border-radius:8px;cursor:pointer}
.btn.subtle{background:#fff;color:var(--brand);border:1px solid rgba(40,116,240,0.12)}
.muted{color:var(--muted)}
.pagination{display:flex;gap:6px;justify-content:center;margin:16px 0}
.page-btn{padding:6px 10px;border-radius:6px;border:1px solid #e6e9ef;background:white;cursor:pointer}
.page-btn.active{background:var(--brand);color:white;border-color:var(--brand)}
.cart-drawer{position:fixed;right:18px;top:80px;width:360px;background:var(--card);padding:12px;border-radius:10px;box-shadow:0 20px 50px rgba(0,0,0,0.15);max-height:80vh;overflow:auto;display:none;z-index:1200}
.cart-item{display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #eef2f8}
.cart-item img{width:64px;height:64px;object-fit:cover;border-radius:6px}
.cart-footer{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
.footer{padding:18px;text-align:center;color:var(--muted)}
.single-product{max-width:1000px;margin:24px auto;background:var(--card);padding:18px;border-radius:10px;box-shadow:0 8px 30px rgba(0,0,0,0.06)}
@media (max-width:920px){.container{grid-template-columns:1fr}.cart-drawer{left:12px;right:12px;width:auto}}
